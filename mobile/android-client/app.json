{
  "expo": {
    "name": "MotoYa",
    "slug": "motoya-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "motoya",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#070B1C", "resizeMode": "contain" },
    "android": {
      "package": "ni.motoya.android",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": ["expo-router", "expo-location", ["expo-image-picker", { "photosPermission": "MotoYa necesita acceso a tus fotos para adjuntar documentos y comprobantes.", "cameraPermission": "MotoYa necesita la cámara para fotografiar documentos y comprobantes." }]],
    "extra": {
      "apiUrl": "https://motoya-api.onrender.com/api"
    }
  }
}
