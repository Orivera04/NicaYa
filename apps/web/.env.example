# Used by Next's server-side /api proxy. The browser always calls /api so its
# HttpOnly refresh cookie remains first-party in every environment.
MOTOYA_API_URL="http://localhost:4000/api"
# Retained for the Socket.io endpoint and backwards-compatible deployments.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
# Opcional. Carto Positron se usa por defecto si no se establece.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"
