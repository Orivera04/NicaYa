DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
API_PORT=4000
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
# Refresh token: HttpOnly cookie. Set COOKIE_SECURE=true in production.
COOKIE_NAME="motoya_refresh"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
# Never reuse this value between environments. Required in production.
FILE_ENCRYPTION_KEY="replace-with-a-different-random-secret-at-least-32-chars"
# Keep rider evidence compact: eight images are uploaded in one request.
MEDIA_MAX_IMAGE_BYTES=350000
